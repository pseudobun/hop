// Copy to Local.xcconfig (gitignored) and fill in your own values.

// Your Apple Developer team id (Xcode → Settings → Accounts, or the OU of your
// "Apple Development" certificate). With it and a signing identity, `just install`
// signs hop, so macOS keeps its Accessibility grant across rebuilds.
DEVELOPMENT_TEAM = ABCDE12345

